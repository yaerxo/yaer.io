---
const links = [['Products', '/#products'], ['About', '/#about'], ['Contact', '/#contact']];
---
<header class="site-header"><div class="container header-inner">
<a class="brand" href="/#home"><span class="wordmark">YAER<span class="brand-dot" aria-hidden="true">.</span></span><span class="brand-expansion">Yet Another<br />Elegant Resolution</span></a>
<nav class="desktop-nav" aria-label="Main navigation">{links.map(([label, href]) => <a href={href}>{label}</a>)}<a class="button button-small" href="/#contact">Get in Touch</a></nav>
<button class="mobile-menu-toggle" type="button" aria-label="Open navigation menu" aria-haspopup="dialog" aria-controls="mobile-navigation"><span class="hamburger-icon" aria-hidden="true"><span></span><span></span><span></span></span></button>
<dialog class="mobile-navigation-sheet" id="mobile-navigation" aria-label="Navigation menu">
<div class="mobile-sheet-header"><a class="brand" href="/#home"><span class="wordmark">YAER<span class="brand-dot" aria-hidden="true">.</span></span><span class="brand-expansion">Yet Another<br />Elegant Resolution</span></a><button class="mobile-menu-close" type="button" aria-label="Close navigation menu" autofocus><span aria-hidden="true">×</span></button></div>
<nav aria-label="Mobile navigation">{links.map(([label, href]) => <a href={href}>{label}<span aria-hidden="true">→</span></a>)}</nav>
</dialog>
</div></header>

<script>
const toggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
const sheet = document.querySelector<HTMLDialogElement>('#mobile-navigation');
if (toggle && sheet) {
  toggle.addEventListener('click', () => sheet.showModal());
  sheet.querySelector('.mobile-menu-close')?.addEventListener('click', () => sheet.close());
  sheet.querySelectorAll('a').forEach(link => link.addEventListener('click', () => sheet.close()));
  const desktop = window.matchMedia('(min-width: 761px)');
  desktop.addEventListener('change', event => { if (event.matches && sheet.open) sheet.close(); });
}
</script>
