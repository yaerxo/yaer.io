const principles = [
 {icon:'users', title:'Real-world inspiration', text:'Ideas shaped by everyday experiences.'},
 {icon:'heart', title:'Built with curiosity', text:"Always exploring whether there’s a better way."},
 {icon:'leaf', title:'Thoughtful and practical', text:'Solutions designed to be useful, simple, and lasting.'},
